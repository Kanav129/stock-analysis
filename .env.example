# =============================================================================
# Deployment / server
# =============================================================================
# Render sets PORT automatically. Local default:
PORT=8001
# Comma-separated browser origins allowed to call the API (Vercel + local Vite).
# Name must be CORS_ORIGINS (with an S). Include https://your-app.vercel.app — no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# On Render free tier, keep false — the dyno sleeps and long boot jobs are unreliable
AUTO_PIPELINE_ENABLED=false
# Calendar day for sync/analysis checkpoints (resume + once-per-day soft gate)
APP_TIMEZONE=Asia/Hong_Kong
# Shared access key for the login page / API Bearer auth. Leave empty to disable auth (local only).
ADMIN_KEY=

# =============================================================================
# Interactive Brokers — Flex Web Service (holdings sync)
# Account Management → Flex Web Service → create a Token + Flex Query
# Query sections: Open Positions (stocks/ETFs). Keep the token secret.
# =============================================================================
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Optional tuning (defaults shown):
# IBKR_FLEX_TIMEOUT_SECONDS=30
# IBKR_FLEX_POLL_INTERVAL_SECONDS=2
# IBKR_FLEX_MAX_POLLS=30
# Sync stage timeouts = ceil(tickers × sec_per_ticker × buffer), floored at 5 minutes.
# Defaults from 2026-07-21/22 daily-sync timings (news ~30s, prices ~200s mean).
# SYNC_NEWS_SECONDS_PER_TICKER=30
# SYNC_PRICE_SECONDS_PER_TICKER=200
# SYNC_TIMEOUT_BUFFER=1.2
# Optional absolute override (split evenly news/prices); leave unset to use the formula:
# SYNC_SCRAPE_TIMEOUT_SECONDS=
# Analysis timeouts = ceil(tickers × sec_per_ticker × buffer), floored at 10 minutes.
# Defaults from Jul 19 full-universe core-report batch (~190s/ticker mean).
# ANALYSIS_CORE_SECONDS_PER_TICKER=190
# ANALYSIS_RESCORE_SECONDS_PER_TICKER=45
# ANALYSIS_TIMEOUT_BUFFER=1.2
# ANALYSIS_TIMEOUT_SECONDS=
# Max concurrent LLM jobs (core analysis / deep dive / rescore)
JOB_MAX_CONCURRENT=1

# =============================================================================
# OpenRouter (OpenAI-compatible API)
# Get your key at: https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# =============================================================================
# Supabase — API keys (for Supabase client SDK; NOT used by this app today)
# Found in: Dashboard → Project Settings → API
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# =============================================================================
# Supabase PostgreSQL — use SESSION POOLER (IPv4 compatible)
# Dashboard → Connect → Connection string → Session pooler
# =============================================================================
POSTGRES_HOST=aws-0-your-region.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USERNAME=postgres.your-project-ref
POSTGRES_PASSWORD=your_supabase_database_password
POSTGRES_SSLMODE=require
# App-side pool so sync writes don't block desk reads (defaults: 2–8)
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=16
POSTGRES_STATEMENT_TIMEOUT=120000
POSTGRES_CONNECT_TIMEOUT=30
STOCK_TABLE=stock_data

# =============================================================================
# MongoDB (news article storage)
# Use MongoDB Atlas or a local instance
# =============================================================================
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=stocks_insights
COLLECTION_NAME=news_articles

# =============================================================================
# ChromaDB (vector store for news RAG)
# Local directory where embeddings are persisted
# =============================================================================
VECTOR_DB_DIRECTORY=./chroma_db
VECTOR_DB_COLLECTION=news_embeddings

# =============================================================================
# Scraping
# News is fetched via yfinance (no separate news API key required).
# =============================================================================
SCRAPE_NUM_ARTICLES=5

# =============================================================================
# Tavily (web search fallback in News RAG)
# Get your key at: https://tavily.com/
# =============================================================================
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# LangSmith (optional — LLM tracing & debugging)
# Get your key at: https://smith.langchain.com/
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=stocks-insights-ai-agent

# =============================================================================
# Analysis engine
# =============================================================================
# Stronger model for final BUY/HOLD/SELL decision synthesis.
ANALYSIS_MODEL=deepseek/deepseek-v4-pro
# In-process schedule intervals (only used when AUTO_PIPELINE_ENABLED=true).
# Prefer GitHub Actions on Render free tier — see .github/workflows/
SYNC_INTERVAL=86400
# Weekly analysis (7 days)
ANALYSIS_INTERVAL=604800

# =============================================================================
# Research report engine
# =============================================================================
# Cheaper model for report section narratives (fundamentals, news, sentiment, etc.).
RESEARCH_MODEL=deepseek/deepseek-v4-flash
# Kronos-small loads PyTorch (~hundreds of MB). Keep true locally; set false on
# Render free/Starter (512 MB) so deep reports skip the forecast instead of OOM.
KRONOS_ENABLED=true

# =============================================================================
# Finnhub — company news, insider transactions, analyst data
# Get your free key at: https://finnhub.io/
# =============================================================================
FINNHUB_API_KEY=your_finnhub_api_key

# =============================================================================
# Alpha Vantage — full financial statements (25 req/day free tier)
# Get your free key at: https://www.alphavantage.co/support/#api-key
# =============================================================================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
